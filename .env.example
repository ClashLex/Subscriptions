# Copy this file to `.env` at the repository root and fill in real values.
# The same file is read by Docker Compose (compose.yaml) and the Express API.
# Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Global API rate limit (requests / 5 min). Raise for demo + test runs.
RATE_LIMIT_MAX=3000

# Automatic billing run interval in minutes. Leave unset (or 0) to disable and
# bill only through the Admin-only POST /billing/run trigger.
BILLING_RUN_INTERVAL_MINUTES=
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# MySQL (used by both compose.yaml and the API server)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=subscriptions
DB_USER=subscriptions_app
DB_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_me_root

# Sessions / security — generate with: openssl rand -base64 48
SESSION_SECRET=replace_with_long_random_value

# Email (password reset links, optional invoice sending)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Demo seed admin (scripts/seed.ts) — set both to seed; use a strong password.
SEED_ADMIN_EMAIL=admin@subscriptions.local
SEED_ADMIN_PASSWORD=Br1ghtloop!Demo

